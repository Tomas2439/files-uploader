<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <div style="margin-bottom: 1.5rem;">
    <a href="<%= file.folderId ? '/drive/folder/' + file.folderId : '/drive' %>" class="btn btn-secondary btn-sm">
      ← Volver a <%= file.folder ? file.folder.name : 'Mi Unidad' %>
    </a>
  </div>

  <div class="file-details-card">
    <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; word-break: break-all;">
      <%= file.name %>
    </h1>

    <div class="file-preview-box">
      <% if (file.mimeType.startsWith('image/')) { %>
        <img src="<%= file.url %>" alt="<%= file.name %>" class="file-preview-image">
      <% } else { %>
        <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">
          <% if (file.mimeType.includes('pdf')) { %>📕<% } else if (file.mimeType.includes('zip') || file.mimeType.includes('rar')) { %>📦<% } else { %>📄<% } %>
        </div>
        <p style="color: var(--text-muted); font-size: 0.9rem;"><%= file.mimeType %></p>
      <% } %>
    </div>

    <div class="meta-grid">
      <div class="meta-item">
        <div class="meta-label">Tamaño de Archivo</div>
        <div class="meta-value"><%= formattedSize %></div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Tipo MIME</div>
        <div class="meta-value" style="font-size: 0.85rem; word-break: break-all;"><%= file.mimeType %></div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Fecha de Carga</div>
        <div class="meta-value"><%= new Date(file.createdAt).toLocaleString('es-ES') %></div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Almacenamiento</div>
        <div class="meta-value"><%= file.storageType === 'cloudinary' ? '☁️ Cloudinary' : '💻 Servidor Local' %></div>
      </div>
    </div>

    <div style="display: flex; gap: 1rem; justify-content: flex-end;">
      <form action="/drive/file/<%= file.id %>/delete" method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar este archivo?');">
        <button type="submit" class="btn btn-danger">🗑️ Eliminar Archivo</button>
      </form>
      <a href="/drive/file/<%= file.id %>/download" class="btn btn-primary" download>
        ⬇️ Descargar Archivo
      </a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
